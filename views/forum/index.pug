//- views/forum/index.pug — Forum listing page
extends ../layout

block content
  .page-header
    .container
      div.flex.items-center(style="justify-content: space-between; flex-wrap: wrap; gap: 1rem;")
        div
          h1 Community Forum
          p Ask questions, share tips, and connect with fellow language enthusiasts
        if currentUser
          a.btn.btn-primary(href="/forum/create")
            span.material-symbols-outlined.icon-inline add
            | New Post

  section.section
    .container
      //- Filter
      form.filter-bar(action="/forum" method="GET")
        .form-group
          label Search
          input.form-control(type="text" name="search" placeholder="Search posts..." value=(search || ''))
        .form-group
          label Language
          select.form-control(name="language")
            option(value="") All Languages
            if languages
              each lang in languages
                option(value=lang.id selected=(language == lang.id))= lang.name
        button.btn.btn-primary(type="submit")
          span.material-symbols-outlined search
          | Filter

      //- Posts
      if posts && posts.length
        each post in posts
          .forum-post
            h3
              a(href=`/forum/${post.id}`)= post.title
            p.text-muted= post.body ? post.body.substring(0, 200) + '...' : ''
            .forum-post-meta
              span.flex.items-center.gap-2
                span.material-symbols-outlined.icon-sm person
                | #{post.user_name}
              if post.language_name
                span.flex.items-center.gap-2
                  span.material-symbols-outlined.icon-sm language
                  | #{post.language_name}
              span.flex.items-center.gap-2
                span.material-symbols-outlined.icon-sm calendar_today
                | #{new Date(post.created_at).toLocaleDateString('en-GB')}
              span.flex.items-center.gap-2
                span.material-symbols-outlined.icon-sm chat_bubble
                | #{post.comment_count || 0} comment#{post.comment_count !== 1 ? 's' : ''}
      else
        .form-card.text-center
          span.material-symbols-outlined(style="font-size: 48px; display: block; margin: 0 auto 1rem; color: var(--text-muted);") forum
          p.text-muted No forum posts yet. Be the first to start a discussion!
