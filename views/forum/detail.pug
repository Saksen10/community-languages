//- views/forum/detail.pug — Forum post detail page
extends ../layout

block content
  section.section
    .container
      .forum-post(style="margin-bottom: 2rem;")
        h2.mb-2= post.title
        .forum-post-meta
          span.flex.items-center.gap-2
            svg.icon-sm(xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor")
              path(stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z")
            | #{post.user_name}
          if post.language_name
            span.flex.items-center.gap-2
              svg.icon-sm(xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor")
                path(stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418")
              | #{post.language_name}
          span.flex.items-center.gap-2
            svg.icon-sm(xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor")
              path(stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5")
            | #{new Date(post.created_at).toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}
        div(style="margin-top: 1.5rem; line-height: 1.8; font-size: 1.125rem;")
          p= post.body

      //- Comments
      h3.flex.items-center.gap-2.mb-4
        svg.icon-inline(xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor")
          path(stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.76c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.076-4.076a1.526 1.526 0 011.037-.443 48.282 48.282 0 005.68-.494c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z")
        | Comments (#{comments ? comments.length : 0})

      if comments && comments.length
        each comment in comments
          .comment
            .comment-header
              strong= comment.user_name
              |  · #{new Date(comment.created_at).toLocaleDateString('en-GB')}
            p(style="margin-top: 0.5rem;")= comment.body

      //- Add comment form
      if currentUser
        div(style="margin-top: 2rem; padding-top: 2rem; border-top: 1px solid var(--border);")
          h3.mb-4 Add a Comment
          form(action=`/forum/${post.id}/comment` method="POST")
            .form-group
              textarea.form-control(name="body" required rows="3" placeholder="Share your thoughts...")
            button.btn.btn-primary(type="submit") Post Comment
      else
        p(style="color: var(--text-muted); margin-top: 1.5rem; padding: 1.5rem; background-color: var(--surface); border-radius: var(--radius-md); border: 1px solid var(--border);")
          a(href="/login") Log in
          |  to leave a comment.

      div(style="margin-top: 2rem;")
        a.btn.btn-outline(href="/forum")
          svg.icon-inline(xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor")
            path(stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18")
          | Back to Forum
