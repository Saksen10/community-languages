//- views/dashboard/teacher.pug — Teacher dashboard
extends ../layout

block content
  .page-header
    .container
      h1 Welcome, #{currentUser.name}!
      p Your teaching dashboard

  section.section
    .container
      //- Stats
      .dashboard-grid
        .dashboard-stat
          .dashboard-stat-icon
            span.material-symbols-outlined.icon-xl(style="color: var(--primary);") menu_book
          .stat-number= lessonCount || 0
          .stat-label Lessons Created
        .dashboard-stat
          .dashboard-stat-icon
            span.material-symbols-outlined.icon-xl(style="color: var(--primary);") group
          .stat-number= learnerCount || 0
          .stat-label Learners Reached
        .dashboard-stat
          .dashboard-stat-icon
            span.material-symbols-outlined.icon-xl(style="color: var(--primary);") fact_check
          .stat-number= quizAttempts || 0
          .stat-label Quiz Attempts
        .dashboard-stat
          .dashboard-stat-icon
            span.material-symbols-outlined.icon-xl(style="color: var(--primary);") military_tech
          .stat-number= currentUser.points || 0
          .stat-label Points Earned

      //- Actions
      div(style="margin-bottom: 3rem;")
        a.btn.btn-primary(href="/lessons/create")
          span.material-symbols-outlined add_circle
          | Create New Lesson

      //- My lessons
      if lessons && lessons.length
        .section-header(style="text-align: left;")
          h2.flex.items-center.gap-2
            span.material-symbols-outlined(style="font-size: 28px;") menu_book
            | Your Lessons
        .card-grid
          each lesson in lessons
            .card
              .card-body
                h3
                  a(href=`/lessons/${lesson.id}`)= lesson.title
                p= lesson.description ? lesson.description.substring(0, 120) + '...' : ''
                .card-meta
                  span.badge.badge-primary= lesson.language_name
                  span.badge(class=`badge-${lesson.difficulty}`)= lesson.difficulty
              .card-footer
                div.flex.gap-2
                  a.btn.btn-sm.btn-outline(href=`/lessons/${lesson.id}/edit`) Edit
                  form.confirm-delete(action=`/lessons/${lesson.id}/delete` method="POST" style="display: inline;")
                    button.btn.btn-sm.btn-danger(type="submit" aria-label="Delete Lesson" style="padding: 0.375rem 0.5rem;")
                      span.material-symbols-outlined.icon-sm(style="margin: 0;") delete
                a.btn.btn-sm.btn-outline(href=`/lessons/${lesson.id}`) View
      else
        .form-card.text-center
          span.material-symbols-outlined(style="font-size: 48px; color: var(--text-muted); margin: 0 auto 1rem; display: block;") add_circle
          p.text-muted You have not created any lessons yet. Click "Create New Lesson" to get started!

      //- Quick links
      div(style="margin-top: 3rem; display: flex; gap: 1rem; flex-wrap: wrap;")
        a.btn.btn-outline(href="/forum")
          span.material-symbols-outlined forum
          | Community Forum
        a.btn.btn-outline(href=`/users/${currentUser.id}`)
          span.material-symbols-outlined person
          | My Profile
