//- views/dashboard/learner.pug — Learner dashboard
extends ../layout

block content
  .page-header
    .container
      h1 Welcome, #{currentUser.name}!
      p Your learning dashboard

  section.section
    .container
      //- Stats
      .dashboard-grid
        .dashboard-stat
          .dashboard-stat-icon
            span.material-symbols-outlined.icon-xl(style="color: var(--primary);") task_alt
          .stat-number= completedCount || 0
          .stat-label Lessons Completed
        .dashboard-stat
          .dashboard-stat-icon
            span.material-symbols-outlined.icon-xl(style="color: var(--primary);") quiz
          .stat-number= quizCount || 0
          .stat-label Quizzes Taken
        .dashboard-stat
          .dashboard-stat-icon
            span.material-symbols-outlined.icon-xl(style="color: var(--primary);") military_tech
          .stat-number= currentUser.points || 0
          .stat-label Points Earned

      //- Recommended lessons
      if recommended && recommended.length
        .section-header(style="text-align: left; margin-top: 3rem;")
          h2.flex.items-center.gap-2
            span.material-symbols-outlined(style="font-size: 28px;") star
            | Recommended for You
        .card-grid
          each lesson in recommended
            .card
              .card-body
                h3
                  a(href=`/lessons/${lesson.id}`)= lesson.title
                p= lesson.description ? lesson.description.substring(0, 120) + '...' : ''
                .card-meta
                  span.badge.badge-primary= lesson.language_name
                  span.badge(class=`badge-${lesson.difficulty}`)= lesson.difficulty
              .card-footer
                span.text-muted.flex.items-center.gap-2
                  span.material-symbols-outlined.icon-sm person
                  | #{lesson.teacher_name}
                a.btn.btn-sm.btn-outline(href=`/lessons/${lesson.id}`) Start

      //- Recently completed
      if completedLessons && completedLessons.length
        .section-header(style="text-align: left; margin-top: 3rem;")
          h2.flex.items-center.gap-2
            span.material-symbols-outlined(style="font-size: 28px; color: var(--success);") history
            | Recently Completed
        .card-grid
          each lesson in completedLessons
            .card
              .card-body
                h3
                  a(href=`/lessons/${lesson.id}`)= lesson.title
                .card-meta
                  span.badge.badge-primary= lesson.language_name
                  span.badge.badge-success Completed
              .card-footer
                span.text-muted= lesson.completed_at ? new Date(lesson.completed_at).toLocaleDateString('en-GB') : ''

      //- Recommended Teachers (Community Matchmaker)
      if recommendedTeachers && recommendedTeachers.length
        .section-header(style="text-align: left; margin-top: 3rem;")
          h2.flex.items-center.gap-2
            span.material-symbols-outlined(style="font-size: 28px; color: var(--secondary);") group_add
            | Recommended Study Buddies
        .card-grid
          each teacher in recommendedTeachers
            .card(style="text-align: center; padding-top: 1.5rem;")
              div(style="width: 80px; height: 80px; border-radius: var(--radius-full); margin: 0 auto 1rem; overflow: hidden; box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);")
                img(src=`https://api.dicebear.com/7.x/initials/svg?seed=${teacher.name}&backgroundColor=00897b,00acc1,039be5&textColor=ffffff` alt=teacher.name style="width: 100%; height: 100%;")
              .card-body(style="padding-top: 0;")
                h3
                  a(href=`/users/${teacher.id}`)= teacher.name
                .card-meta(style="justify-content: center; margin-top: 0.5rem;")
                  span.badge.badge-success Teacher
                p.text-muted(style="font-size: 0.9rem; margin-top: 0.5rem;")= teacher.spoken_languages ? 'Speaks: ' + teacher.spoken_languages : ''
              .card-footer(style="justify-content: center;")
                a.btn.btn-sm.btn-outline(href=`/users/${teacher.id}`) View Profile

      //- Quick links
      div(style="margin-top: 3rem; display: flex; gap: 1rem; flex-wrap: wrap;")
        a.btn.btn-primary(href="/lessons")
          span.material-symbols-outlined menu_book
          | Browse Lessons
        a.btn.btn-outline(href="/forum")
          span.material-symbols-outlined forum
          | Community Forum
        a.btn.btn-outline(href=`/users/${currentUser.id}`)
          span.material-symbols-outlined person
          | My Profile
