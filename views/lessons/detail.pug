//- views/lessons/detail.pug — Lesson detail page
extends ../layout

block content
  .container(style="margin-top: 2rem; margin-bottom: 1rem;")
    a.btn.btn-sm.btn-outline(href="/lessons" style="display: inline-flex;")
      span.material-symbols-outlined.icon-inline arrow_back
      | Back to Lessons

  section.section(style="padding-top: 1rem;")
    .container
      div(style="display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 2rem;")
        
        //- Main content
        .lesson-detail
          .lesson-detail-header
            .card-meta(style="margin-top: 0; margin-bottom: 1rem;")
              span.badge.badge-primary= lesson.language_name
              span.badge(class=`badge-${lesson.difficulty}`)= lesson.difficulty
              if lesson.category_name
                span.tag= lesson.category_name
            h1= lesson.title
            p.text-muted(style="font-size: 1.125rem;")= lesson.description
            
          .lesson-detail-content
            h2.flex.items-center.gap-2
              span.material-symbols-outlined import_contacts
              | Lesson Content
            div(style="line-height: 1.8; margin-bottom: 2rem;")
              p= lesson.content

            if vocabulary && vocabulary.length
              h3 Vocabulary
              ul.vocab-list
                each item in vocabulary
                  li
                    strong= item.term
                    |  — #{item.translation}
                    if item.notes
                      span.text-muted(style="font-size: 0.875rem; margin-left: 0.5rem;") (#{item.notes})

            if quiz && quiz.length
              h3 Knowledge Check
              if userHasCompletedQuiz
                .flash.flash-success
                  span.material-symbols-outlined fact_check
                  span You have already completed this quiz! (Score: #{userQuizScore}/#{quiz.length})
              else if userEnrolled
                .form-card(style="margin: 2rem 0; padding: 2rem; max-width: 100%;")
                  form(action=`/lessons/${lesson.id}/quiz` method="POST")
                    each q, index in quiz
                      .form-group(style="margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border);")
                        label(style="font-size: 1.125rem; margin-bottom: 1rem;") #{index + 1}. #{q.question}
                        each opt in [q.option_a, q.option_b, q.option_c, q.option_d]
                          if opt
                            div(style="margin-bottom: 0.5rem;")
                              label(style="display: flex; align-items: center; font-weight: normal; cursor: pointer;")
                                input(type="radio" name=`answer_${q.id}` value=opt required style="margin-right: 0.75rem; width: 1.25rem; height: 1.25rem;")
                                | #{opt}
                    button.btn.btn-primary.btn-block(type="submit") Submit Answers
              else
                .form-card.text-center(style="margin: 2rem 0; padding: 2rem; max-width: 100%;")
                  p(style="margin-bottom: 1rem;") Please enroll in this lesson to take the quiz.
                  form(action=`/lessons/${lesson.id}/enroll` method="POST")
                    button.btn.btn-primary(type="submit")
                      span.material-symbols-outlined.icon-inline add_circle
                      | Enroll Now

        //- Sidebar
        aside
          .lesson-sidebar(style="margin-bottom: 2rem;")
            h3 Lesson Details
            ul(style="margin-bottom: 1.5rem;")
              li.flex.items-center.gap-2(style="margin-bottom: 0.75rem;")
                span.material-symbols-outlined.icon-sm.text-muted person
                strong Teacher:
                a(href=`/users/${lesson.teacher_id}`)= lesson.teacher_name
              li.flex.items-center.gap-2(style="margin-bottom: 0.75rem;")
                span.material-symbols-outlined.icon-sm.text-muted language
                strong Language:
                span= lesson.language_name
              li.flex.items-center.gap-2(style="margin-bottom: 0.75rem;")
                span.material-symbols-outlined.icon-sm.text-muted trending_up
                strong Level:
                span= lesson.difficulty
              li.flex.items-center.gap-2
                span.material-symbols-outlined.icon-sm.text-muted group
                strong Enrolled:
                span #{enrollmentCount || 0} students

            if currentUser
              if isTeacher
                h4 Teacher Actions
                a.btn.btn-outline.btn-block(href=`/lessons/${lesson.id}/edit` style="margin-bottom: 0.5rem;")
                  span.material-symbols-outlined.icon-inline edit
                  | Edit Lesson
                form.confirm-delete(action=`/lessons/${lesson.id}/delete` method="POST")
                  button.btn.btn-danger.btn-block(type="submit")
                    span.material-symbols-outlined.icon-inline delete
                    | Delete Lesson
              else if userEnrolled
                .flash.flash-success(style="margin: 0 0 1rem 0; padding: 0.75rem;") You are enrolled in this lesson.
              else
                form(action=`/lessons/${lesson.id}/enroll` method="POST")
                  button.btn.btn-primary.btn-block(type="submit")
                    span.material-symbols-outlined.icon-inline add_circle
                    | Enroll in Lesson
            else
              p.text-muted
                a(href="/login") Log in
                |  to enroll and take quizzes.

          //- Tags section
          if tags && tags.length
            .lesson-sidebar
              h3 Tags
              div.flex(style="flex-wrap: wrap; gap: 0.5rem;")
                each tag in tags
                  a.tag(href=`/lessons?search=${tag.name}`) ##{tag.name}
