//- views/lessons/edit.pug — Edit lesson form
extends ../layout

block content
  section.section
    .container
      .form-card(style="max-width: 800px;")
        h2.flex.items-center.justify-center.gap-2
          span.material-symbols-outlined(style="font-size: 28px;") edit
          | Edit Lesson
        form(action=`/lessons/${lesson.id}/edit` method="POST")
          .form-group
            label(for="title") Lesson Title
            input#title.form-control(type="text" name="title" required value=lesson.title)
          
          .form-group
            label(for="description") Short Description
            textarea#description.form-control(name="description" rows="3" required)= lesson.description
            
          div(style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;")
            .form-group
              label(for="language_id") Language
              select#language_id.form-control(name="language_id" required)
                if languages
                  each lang in languages
                    option(value=lang.id selected=(lesson.language_id == lang.id))= lang.name
            
            .form-group
              label(for="difficulty") Difficulty Level
              select#difficulty.form-control(name="difficulty" required)
                option(value="beginner" selected=(lesson.difficulty == 'beginner')) Beginner
                option(value="intermediate" selected=(lesson.difficulty == 'intermediate')) Intermediate
                option(value="advanced" selected=(lesson.difficulty == 'advanced')) Advanced
                
          .form-group
            label(for="category_id") Category (optional)
            select#category_id.form-control(name="category_id")
              option(value="") No Category
              if categories
                each cat in categories
                  option(value=cat.id selected=(lesson.category_id == cat.id))= cat.name

          .form-group
            label(for="content") Lesson Content
            textarea#content.form-control(name="content" rows="15" required)= lesson.content
            
          button.btn.btn-primary.btn-block(type="submit" style="margin-top: 2rem;") Update Lesson
          
        div(style="margin-top: 1rem; text-align: center;")
          a(href=`/lessons/${lesson.id}`) Cancel
