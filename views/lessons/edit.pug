//- views/lessons/edit.pug — Edit lesson page
extends ../layout

block content
  section.section
    .container
      .form-card(style="max-width: 700px;")
        h2 ✏️ Edit Lesson
        form(action=`/lessons/${lesson.id}/edit` method="POST")
          .form-group
            label(for="title") Lesson Title
            input#title.form-control(type="text" name="title" required value=lesson.title)
          .form-group
            label(for="language_id") Language
            select#language_id.form-control(name="language_id" required)
              if languages
                each lang in languages
                  option(value=lang.id selected=(lang.id === lesson.language_id))= lang.name
          .form-group
            label(for="category_id") Category
            select#category_id.form-control(name="category_id" required)
              if categories
                each cat in categories
                  option(value=cat.id selected=(cat.id === lesson.category_id))= cat.name
          .form-group
            label(for="difficulty") Difficulty Level
            select#difficulty.form-control(name="difficulty")
              option(value="beginner" selected=(lesson.difficulty === 'beginner')) Beginner
              option(value="intermediate" selected=(lesson.difficulty === 'intermediate')) Intermediate
              option(value="advanced" selected=(lesson.difficulty === 'advanced')) Advanced
          .form-group
            label(for="description") Short Description
            textarea#description.form-control(name="description" required rows="3")= lesson.description
          .form-group
            label(for="content") Lesson Content
            textarea#content.form-control(name="content" required rows="10")= lesson.content
          .form-group
            label(for="vocabulary") Vocabulary
            textarea#vocabulary.form-control(name="vocabulary" rows="5")= lesson.vocabulary
          .form-group
            label(for="media_url") Media URL
            input#media_url.form-control(type="url" name="media_url" value=(lesson.media_url || ''))
          button.btn.btn-primary.btn-block(type="submit") Save Changes
          a.btn.btn-outline.btn-block(href=`/lessons/${lesson.id}` style="margin-top: 12px;") Cancel
