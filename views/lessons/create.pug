//- views/lessons/create.pug — Create lesson form
extends ../layout

block content
  section.section
    .container
      .form-card(style="max-width: 800px;")
        h2.flex.items-center.justify-center.gap-2
          span.material-symbols-outlined(style="font-size: 28px;") add_circle
          | Create New Lesson
        form(action="/lessons/create" method="POST")
          .form-group
            label(for="title") Lesson Title
            input#title.form-control(type="text" name="title" required)
          
          .form-group
            label(for="description") Short Description
            textarea#description.form-control(name="description" rows="3" required)
            
          div(style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;")
            .form-group
              label(for="language_id") Language
              select#language_id.form-control(name="language_id" required)
                option(value="") Select Language
                if languages
                  each lang in languages
                    option(value=lang.id)= lang.name
            
            .form-group
              label(for="difficulty") Difficulty Level
              select#difficulty.form-control(name="difficulty" required)
                option(value="beginner") Beginner
                option(value="intermediate") Intermediate
                option(value="advanced") Advanced
                
          .form-group
            label(for="category_id") Category (optional)
            select#category_id.form-control(name="category_id")
              option(value="") No Category
              if categories
                each cat in categories
                  option(value=cat.id)= cat.name

          .form-group
            label(for="content") Lesson Content
            textarea#content.form-control(name="content" rows="15" required placeholder="Write your lesson content here. You can include grammar explanations, cultural notes, and examples.")
            
          .form-group
            label(for="tags") Tags (comma separated, optional)
            input#tags.form-control(type="text" name="tags" placeholder="e.g. grammar, greetings, travel")

          button.btn.btn-primary.btn-block(type="submit" style="margin-top: 2rem;") Create Lesson
