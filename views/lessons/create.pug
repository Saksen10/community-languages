//- views/lessons/create.pug — Create lesson form
extends ../layout

block head
  link(href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet")
  style.
    #editor-container {
      height: 350px;
      background-color: var(--surface);
      border: 1px solid var(--border);
      border-top: none;
      border-radius: 0 0 var(--radius-md) var(--radius-md);
      font-family: var(--font-sans);
      font-size: 1rem;
    }
    .ql-toolbar.ql-snow {
      border: 1px solid var(--border);
      border-radius: var(--radius-md) var(--radius-md) 0 0;
      background-color: var(--bg-color);
      font-family: var(--font-sans);
    }
    .ql-editor {
      font-size: 1rem;
      line-height: 1.6;
    }

block content
  section.section
    .container
      .form-card(style="max-width: 800px;")
        h2.flex.items-center.justify-center.gap-2
          span.material-symbols-outlined(style="font-size: 28px;") add_circle
          | Create New Lesson
        form#lesson-form(action="/lessons/create" method="POST")
          .form-group
            label(for="title") Lesson Title
            input#title.form-control(type="text" name="title" required)
          
          .form-group
            label(for="description") Short Description
            textarea#description.form-control(name="description" rows="3" required)
            
          div(style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;")
            .form-group
              label(for="language_id") Language
              select#language_id.form-control(name="language_id" required)
                option(value="") Select Language
                if languages
                  each lang in languages
                    option(value=lang.id)= lang.name
            
            .form-group
              label(for="difficulty") Difficulty Level
              select#difficulty.form-control(name="difficulty" required)
                option(value="beginner") Beginner
                option(value="intermediate") Intermediate
                option(value="advanced") Advanced
                
          .form-group
            label(for="category_id") Category (optional)
            select#category_id.form-control(name="category_id")
              option(value="") No Category
              if categories
                each cat in categories
                  option(value=cat.id)= cat.name

          .form-group
            label(for="content") Lesson Content
            div#editor-container
            textarea#content.form-control(name="content" style="display: none;" required)
            
          .form-group
            label(for="tags") Tags (comma separated, optional)
            input#tags.form-control(type="text" name="tags" placeholder="e.g. grammar, greetings, travel")

          button.btn.btn-primary.btn-block(type="submit" style="margin-top: 2rem;") Create Lesson

block scripts
  script(src="https://cdn.quilljs.com/1.3.6/quill.js")
  script.
    document.addEventListener('DOMContentLoaded', function() {
      var quill = new Quill('#editor-container', {
        theme: 'snow',
        placeholder: 'Write your lesson content here. You can include grammar explanations, cultural notes, and examples.',
        modules: {
          toolbar: [
            [{ 'header': [2, 3, false] }],
            ['bold', 'italic', 'underline', 'strike'],
            [{ 'list': 'ordered'}, { 'list': 'bullet' }],
            ['link', 'blockquote', 'code-block'],
            ['clean']
          ]
        }
      });

      var form = document.getElementById('lesson-form');
      form.onsubmit = function() {
        // Populate hidden form on submit
        var content = document.querySelector('textarea[name=content]');
        content.value = quill.root.innerHTML;
        
        // Basic validation: prevent submitting if Quill is effectively empty
        if (quill.getText().trim().length === 0 && !quill.root.innerHTML.includes('<img')) {
          alert('Lesson content cannot be empty.');
          return false;
        }
        return true;
      };
    });
