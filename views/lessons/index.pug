//- views/lessons/index.pug — Lessons listing page
extends ../layout

block content
  .page-header.text-center
    .container
      h1 Browse Lessons
      p Explore community language lessons created by our teachers

  section.section
    .container
      //- Filter bar
      form.filter-bar(action="/lessons" method="GET")
        .form-group
          label Search
          input.form-control(type="text" name="search" placeholder="Search lessons..." value=(search || ''))
        .form-group
          label Language
          select.form-control(name="language")
            option(value="") All Languages
            if languages
              each lang in languages
                option(value=lang.id selected=(language == lang.id))= lang.name
        .form-group
          label Category
          select.form-control(name="category")
            option(value="") All Categories
            if categories
              each cat in categories
                option(value=cat.id selected=(category == cat.id))= cat.name
        .form-group
          label Difficulty
          select.form-control(name="difficulty")
            option(value="") All Levels
            option(value="beginner" selected=(difficulty === 'beginner')) Beginner
            option(value="intermediate" selected=(difficulty === 'intermediate')) Intermediate
            option(value="advanced" selected=(difficulty === 'advanced')) Advanced
        button.btn.btn-primary(type="submit")
          svg(xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor")
            path(stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z")
          | Filter

      if lessons && lessons.length
        p.mb-4.text-muted Showing #{lessons.length} lesson#{lessons.length !== 1 ? 's' : ''}
        .card-grid
          each lesson in lessons
            .card
              .card-body
                h3
                  a(href=`/lessons/${lesson.id}`)= lesson.title
                p= lesson.description ? lesson.description.substring(0, 140) + '...' : ''
                .card-meta
                  span.badge.badge-primary= lesson.language_name
                  span.badge.badge-warning= lesson.category_name
                  span.badge(class=`badge-${lesson.difficulty}`)= lesson.difficulty
              .card-footer
                span.text-muted.flex.items-center.gap-2
                  svg.icon-sm(xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor")
                    path(stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z")
                  | #{lesson.teacher_name}
                a.btn.btn-sm.btn-outline(href=`/lessons/${lesson.id}`) View Lesson
      else
        .form-card.text-center
          svg(xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width: 48px; height: 48px; margin: 0 auto 1rem; color: var(--text-muted);")
            path(stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z")
          p.text-muted No lessons found. Try adjusting your filters.
