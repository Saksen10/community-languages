//- views/users/index.pug — Users listing page
extends ../layout

block content
  .page-header.text-center
    .container
      h1 Community Members
      p Connect with teachers and fellow language learners

  section.section
    .container
      //- Filter bar
      form.filter-bar(action="/users" method="GET")
        .form-group
          label Search by Name
          input.form-control(type="text" name="search" placeholder="Find a member..." value=(search || ''))
        .form-group
          label Role
          select.form-control(name="role")
            option(value="") All Members
            option(value="teacher" selected=(role == 'teacher')) Teachers
            option(value="learner" selected=(role == 'learner')) Learners
        button.btn.btn-primary(type="submit")
          span.material-symbols-outlined search
          | Filter

      //- Results
      if users && users.length
        .card-grid
          each user in users
            .card(style="text-align: center; padding-top: 1.5rem;")
              //- Avatar placeholder
              div(style="width: 80px; height: 80px; border-radius: var(--radius-full); background: linear-gradient(135deg, var(--primary-light), var(--secondary-light)); color: var(--primary); display: flex; align-items: center; justify-content: center; font-size: 2rem; font-weight: bold; margin: 0 auto 1rem;")
                | #{user.name.charAt(0).toUpperCase()}
              
              .card-body(style="padding-top: 0;")
                h3
                  a(href=`/users/${user.id}`)= user.name
                
                div(style="margin: 0.5rem 0;")
                  if user.role === 'teacher'
                    span.badge.badge-success
                      span.material-symbols-outlined.icon-sm(style="margin-right: 4px; vertical-align: text-bottom;") school
                      | Teacher
                  else
                    span.badge.badge-primary
                      span.material-symbols-outlined.icon-sm(style="margin-right: 4px; vertical-align: text-bottom;") menu_book
                      | Learner
                      
                if user.bio
                  p.text-muted(style="font-size: 0.9rem; margin-top: 1rem;")= user.bio.substring(0, 80) + (user.bio.length > 80 ? '...' : '')
                
              .card-footer(style="justify-content: center;")
                a.btn.btn-sm.btn-outline(href=`/users/${user.id}`) View Profile
      else
        .form-card.text-center
          span.material-symbols-outlined(style="font-size: 48px; display: block; margin: 0 auto 1rem; color: var(--text-muted);") search_off
          p.text-muted No members found matching your criteria.
