//- views/users/index.pug — Users list page
extends ../layout

block content
  .page-header.text-center
    .container
      h1 Community Members
      p Browse our community of learners and teachers

  section.section
    .container
      //- Filter bar
      form.filter-bar(action="/users" method="GET")
        .form-group
          label Search
          input.form-control(type="text" name="search" placeholder="Search by name..." value=(search || ''))
        .form-group
          label Role
          select.form-control(name="role")
            option(value="") All Roles
            option(value="teacher" selected=(role === 'teacher')) Teachers
            option(value="learner" selected=(role === 'learner')) Learners
        .form-group
          label Language
          select.form-control(name="language")
            option(value="") All Languages
            if languages
              each lang in languages
                option(value=lang.id selected=(language == lang.id))= lang.name
        button.btn.btn-primary(type="submit")
          svg(xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor")
            path(stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z")
          | Filter

      //- Results count
      if users && users.length
        p.mb-4.text-muted Showing #{users.length} member#{users.length !== 1 ? 's' : ''}

      //- User cards grid
      if users && users.length
        .card-grid
          each user in users
            .card
              .card-body
                div.flex.items-center.gap-4.mb-4
                  .profile-avatar(style="width: 50px; height: 50px; font-size: 1.2rem; box-shadow: none;")= user.name ? user.name.charAt(0).toUpperCase() : '?'
                  div
                    h3(style="margin-bottom: 0.25rem;")
                      a(href=`/users/${user.id}`)= user.name
                    span.badge(class=user.role === 'teacher' ? 'badge-warning' : 'badge-primary')= user.role
                if user.bio
                  p.text-muted= user.bio.substring(0, 100) + (user.bio.length > 100 ? '...' : '')
                .card-meta
                  if user.spoken_languages
                    span.tag.flex.items-center.gap-2
                      svg.icon-sm(xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor")
                        path(stroke-linecap="round" stroke-linejoin="round" d="M12 20.25c4.97 0 9-3.694 9-8.25s-4.03-8.25-9-8.25S3 7.444 3 12c0 2.104.859 4.023 2.273 5.48.432.447.74 1.04.586 1.641a4.483 4.483 0 01-.923 1.785A5.969 5.969 0 006 21c1.282 0 2.47-.402 3.445-1.087.81.22 1.668.337 2.555.337z")
                      | #{user.spoken_languages}
                  if user.community_location
                    span.tag.flex.items-center.gap-2
                      svg.icon-sm(xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor")
                        path(stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z")
                        path(stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z")
                      | #{user.community_location}
              .card-footer
                span.badge.badge-warning.flex.items-center.gap-2
                  svg.icon-sm(xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor")
                    path(stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z")
                  | #{user.points || 0} points
                a.btn.btn-sm.btn-outline(href=`/users/${user.id}`) View Profile
      else
        .form-card.text-center
          svg(xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width: 48px; height: 48px; margin: 0 auto 1rem; color: var(--text-muted);")
            path(stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z")
          p.text-muted No members found matching your criteria.
