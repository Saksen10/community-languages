//- views/users/profile.pug — User profile page
extends ../layout

block content
  section.section
    .container
      .profile-header
        .profile-avatar(style="padding: 0; overflow: hidden; background: none; box-shadow: none;")
          img(src=`https://api.dicebear.com/7.x/initials/svg?seed=${user.name}&backgroundColor=00897b,00acc1,039be5&textColor=ffffff` alt=user.name style="width: 100%; height: 100%; border-radius: 50%; box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);")
        .profile-info
          div.flex.items-center(style="justify-content: space-between; flex-wrap: wrap; gap: 1rem;")
            div
              h1= user.name
              if user.role === 'teacher'
                span.badge.badge-success
                  span.material-symbols-outlined.icon-sm(style="margin-right: 4px; vertical-align: text-bottom;") school
                  | Teacher
              else
                span.badge.badge-primary
                  span.material-symbols-outlined.icon-sm(style="margin-right: 4px; vertical-align: text-bottom;") menu_book
                  | Learner
            
            if currentUser && currentUser.id === user.id
              a.btn.btn-outline(href="/settings")
                span.material-symbols-outlined.icon-inline edit
                | Edit Profile
                
          div(style="margin-top: 1.5rem; display: flex; gap: 2rem; flex-wrap: wrap;")
            if user.location
              div.flex.items-center.gap-2.text-muted
                span.material-symbols-outlined.icon-sm location_on
                | #{user.location}
            div.flex.items-center.gap-2.text-muted
              span.material-symbols-outlined.icon-sm calendar_today
              | Joined #{new Date(user.created_at).toLocaleDateString('en-GB', { month: 'long', year: 'numeric' })}
              
          if user.spoken_languages
            div(style="margin-top: 1rem;")
              strong.flex.items-center.gap-2
                span.material-symbols-outlined.icon-sm language
                | Speaks:
              span.text-muted(style="margin-left: 2rem;")= user.spoken_languages
              
          if user.learning_interests
            div(style="margin-top: 0.5rem;")
              strong.flex.items-center.gap-2
                span.material-symbols-outlined.icon-sm translate
                | Learning:
              span.text-muted(style="margin-left: 2rem;")= user.learning_interests
              
          .profile-stats
            .profile-stat
              .stat-number= user.points || 0
              .stat-label Community Points
            if user.role === 'teacher'
              .profile-stat
                .stat-number= lessonCount || 0
                .stat-label Lessons Created
            if user.role === 'learner'
              .profile-stat
                .stat-number= completedLessons ? completedLessons.length : 0
                .stat-label Lessons Completed

      div(style="display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 2rem;")
        //- Main content (Lessons)
        div
          if user.role === 'teacher'
            h2(style="margin-bottom: 1.5rem;") Lessons by #{user.name}
            if lessons && lessons.length
              .card-grid(style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));")
                each lesson in lessons
                  .card
                    .card-body
                      h3
                        a(href=`/lessons/${lesson.id}`)= lesson.title
                      .card-meta(style="margin-top: 0.5rem;")
                        span.badge.badge-primary= lesson.language_name
                        span.badge(class=`badge-${lesson.difficulty}`)= lesson.difficulty
                    .card-footer
                      a.btn.btn-sm.btn-outline(href=`/lessons/${lesson.id}`) View Lesson
            else
              .form-card.text-center(style="margin: 0; padding: 2rem;")
                p.text-muted #{user.name} hasn't created any lessons yet.
          else
            h2(style="margin-bottom: 1.5rem;") Learning Progress
            if completedLessons && completedLessons.length
              .card-grid(style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));")
                each lesson in completedLessons
                  .card
                    .card-body
                      h3
                        a(href=`/lessons/${lesson.id}`)= lesson.title
                      .card-meta(style="margin-top: 0.5rem;")
                        span.badge.badge-primary= lesson.language_name
                        span.badge.badge-success Completed
                    .card-footer
                      span.text-muted= new Date(lesson.completed_at).toLocaleDateString('en-GB')
            else
              .form-card.text-center(style="margin: 0; padding: 2rem;")
                p.text-muted #{user.name} hasn't completed any lessons yet.

        //- Sidebar (About)
        aside
          h3(style="margin-bottom: 1.5rem;") About #{user.name}
          .form-card(style="margin: 0; padding: 2rem;")
            if user.bio
              p(style="line-height: 1.8;")= user.bio
            else
              p.text-muted #{user.name} hasn't written a bio yet.
