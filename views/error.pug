//- views/error.pug — Error page
extends layout

block content
  section.section(style="text-align: center; min-height: 50vh; display: flex; align-items: center;")
    .container
      h1(style="font-size: 4rem; color: var(--primary); margin-bottom: 16px;")= status || 500
      h2(style="margin-bottom: 16px;")= message || 'Something went wrong'
      p(style="color: var(--text-light); margin-bottom: 32px;") Sorry, the page you are looking for could not be found or an error occurred.
      a.btn.btn-primary(href="/") ← Back to Home
