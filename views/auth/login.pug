//- views/auth/login.pug — Login page
extends ../layout

block content
  section.section
    .container
      .form-card
        h2.flex.items-center.justify-center.gap-2
          span.material-symbols-outlined(style="font-size: 28px;") login
          | Log In
        form(action="/login" method="POST")
          .form-group
            label(for="email") Email Address
            input#email.form-control(type="email" name="email" required placeholder="you@example.com")
          .form-group
            label(for="password") Password
            input#password.form-control(type="password" name="password" required placeholder="Your password")
          button.btn.btn-primary.btn-block(type="submit") Log In
        p(style="text-align: center; margin-top: 1rem; color: var(--text-muted);")
          | Don't have an account?
          a(href="/register")  Register here
