//- views/auth/login.pug — Login page
extends ../layout

block content
  section.section
    .container
      .form-card
        h2.flex.items-center.justify-center.gap-2
          svg.icon-inline(xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width: 28px; height: 28px;")
            path(stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1121.75 8.25z")
          | Log In
        form(action="/login" method="POST")
          .form-group
            label(for="email") Email Address
            input#email.form-control(type="email" name="email" required placeholder="you@example.com")
          .form-group
            label(for="password") Password
            input#password.form-control(type="password" name="password" required placeholder="Your password")
          button.btn.btn-primary.btn-block(type="submit") Log In
        p(style="text-align: center; margin-top: 1rem; color: var(--text-muted);")
          | Don't have an account?
          a(href="/register")  Register here
