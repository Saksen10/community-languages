//- views/layout.pug — Master layout template
doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    meta(name="description" content="Community Languages: Teach and Learn — Preserve and share community languages")
    title #{title ? title + ' | ' : ''}Community Languages
    link(rel="stylesheet" href="/css/style.css")
  body
    //- Header navigation
    header.header
      nav.nav.container
        a.nav-brand(href="/")
          svg(xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor")
            path(stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418")
          span Community Languages
        button#nav-toggle.nav-toggle(aria-label="Toggle navigation")
          svg(xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor")
            path(stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5")
        .nav-links#nav-links
          a(href="/" class=(currentPath === '/' ? 'active' : '')) Home
          a(href="/about" class=(currentPath === '/about' ? 'active' : '')) About
          a(href="/lessons" class=(currentPath === '/lessons' ? 'active' : '')) Lessons
          a(href="/categories" class=(currentPath === '/categories' ? 'active' : '')) Languages
          a(href="/users" class=(currentPath === '/users' ? 'active' : '')) Users
          a(href="/forum" class=(currentPath === '/forum' ? 'active' : '')) Forum
          if currentUser
            a(href="/dashboard" class=(currentPath === '/dashboard' ? 'active' : '')) Dashboard
            a(href="/logout" onclick="event.preventDefault();document.getElementById('logout-form').submit();") Logout
            form#logout-form(action="/logout" method="POST" style="display:none")
          else
            a(href="/login" class=(currentPath === '/login' ? 'active' : '')) Login
            a(href="/register" class=(currentPath === '/register' ? 'active' : '')) Register

    //- Flash messages
    .container
      if success && success.length
        each msg in success
          .flash.flash-success
            svg.icon-inline(xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor")
              path(stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z")
            span= msg
      if error && error.length
        each msg in error
          .flash.flash-error
            svg.icon-inline(xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor")
              path(stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z")
            span= msg

    //- Main content
    main.main-content
      block content

    //- Footer
    footer.footer
      .footer-content
        div
          h4
            svg.icon-inline(xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="margin-right: 8px;")
              path(stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418")
            | Community Languages
          p Preserving and sharing community languages through education and connection.
        div
          h4 Quick Links
          a(href="/lessons") Browse Lessons
          a(href="/categories") Languages
          a(href="/users") Find Teachers
          a(href="/forum") Community Forum
        div
          h4 Get Involved
          a(href="/register") Create Account
          a(href="/about") About Us
      .footer-bottom
        p &copy; #{new Date().getFullYear()} Community Languages: Teach and Learn — Language Connect

    script(src="/js/main.js")
