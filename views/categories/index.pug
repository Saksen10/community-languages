//- views/categories/index.pug — Categories, Languages, Tags page
extends ../layout

block content
  .page-header.text-center
    .container
      h1 Browse by Language, Category &amp; Tag
      p Explore our lessons organised by language, topic, and skill

  section.section
    .container
      //- Languages
      .section-header(style="text-align: left;")
        h2.flex.items-center.gap-2
          span.material-symbols-outlined(style="font-size: 28px;") language
          | Languages
        p Choose a language to explore
      if languages && languages.length
        .card-grid
          each lang in languages
            .card
              .card-body
                h3= lang.name
                p.text-muted= lang.description ? lang.description.substring(0, 100) + '...' : ''
                if lang.lesson_count !== undefined
                  .card-meta
                    span.badge.badge-primary #{lang.lesson_count} lesson#{lang.lesson_count !== 1 ? 's' : ''}
              .card-footer
                a.btn.btn-sm.btn-outline(href=`/lessons?language=${lang.id}`) Browse

      //- Categories
      .section-header(style="text-align: left; margin-top: 4rem;")
        h2.flex.items-center.gap-2
          span.material-symbols-outlined(style="font-size: 28px;") folder
          | Categories
        p Browse by topic
      if categories && categories.length
        .card-grid
          each cat in categories
            .card
              .card-body
                h3= cat.name
                p.text-muted= cat.description ? cat.description.substring(0, 100) + '...' : ''
                if cat.lesson_count !== undefined
                  .card-meta
                    span.badge.badge-warning #{cat.lesson_count} lesson#{cat.lesson_count !== 1 ? 's' : ''}
              .card-footer
                a.btn.btn-sm.btn-outline(href=`/lessons?category=${cat.id}`) Browse

      //- Tags
      .section-header(style="text-align: left; margin-top: 4rem;")
        h2.flex.items-center.gap-2
          span.material-symbols-outlined(style="font-size: 28px;") label
          | Tags
        p Quick access by topic tag
      if tags && tags.length
        div.flex(style="flex-wrap: wrap; gap: 0.75rem;")
          each tag in tags
            a.tag(href=`/lessons?search=${tag.name}` style="font-size: 1rem; padding: 0.5rem 1rem;") ##{tag.name}
