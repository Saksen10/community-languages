//- views/categories/index.pug — Categories, Languages, Tags page
extends ../layout

block content
  .page-header.text-center
    .container
      h1 Browse by Language, Category &amp; Tag
      p Explore our lessons organised by language, topic, and skill

  section.section
    .container
      //- Languages
      .section-header(style="text-align: left;")
        h2.flex.items-center.gap-2
          svg.icon-inline(xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor")
            path(stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418")
          | Languages
        p Choose a language to explore
      if languages && languages.length
        .card-grid
          each lang in languages
            .card
              .card-body
                h3= lang.name
                p.text-muted= lang.description ? lang.description.substring(0, 100) + '...' : ''
                if lang.lesson_count !== undefined
                  .card-meta
                    span.badge.badge-primary #{lang.lesson_count} lesson#{lang.lesson_count !== 1 ? 's' : ''}
              .card-footer
                a.btn.btn-sm.btn-outline(href=`/lessons?language=${lang.id}`) Browse

      //- Categories
      .section-header(style="text-align: left; margin-top: 4rem;")
        h2.flex.items-center.gap-2
          svg.icon-inline(xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor")
            path(stroke-linecap="round" stroke-linejoin="round" d="M3.75 9.776c.112-.017.227-.026.344-.026h15.812c.117 0 .232.009.344.026m-16.5 0a2.25 2.25 0 00-1.883 2.542l.857 6a2.25 2.25 0 002.227 1.932H19.05a2.25 2.25 0 002.227-1.932l.857-6a2.25 2.25 0 00-1.883-2.542m-16.5 0V6A2.25 2.25 0 016 3.75h3.879a1.5 1.5 0 011.06.44l2.122 2.12a1.5 1.5 0 001.06.44H18A2.25 2.25 0 0120.25 9v.776")
          | Categories
        p Browse by topic
      if categories && categories.length
        .card-grid
          each cat in categories
            .card
              .card-body
                h3= cat.name
                p.text-muted= cat.description ? cat.description.substring(0, 100) + '...' : ''
                if cat.lesson_count !== undefined
                  .card-meta
                    span.badge.badge-warning #{cat.lesson_count} lesson#{cat.lesson_count !== 1 ? 's' : ''}
              .card-footer
                a.btn.btn-sm.btn-outline(href=`/lessons?category=${cat.id}`) Browse

      //- Tags
      .section-header(style="text-align: left; margin-top: 4rem;")
        h2.flex.items-center.gap-2
          svg.icon-inline(xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor")
            path(stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 003 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 005.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 009.568 3z")
            path(stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6z")
          | Tags
        p Quick access by topic tag
      if tags && tags.length
        div.flex(style="flex-wrap: wrap; gap: 0.75rem;")
          each tag in tags
            a.tag(href=`/lessons?search=${tag.name}` style="font-size: 1rem; padding: 0.5rem 1rem;") ##{tag.name}
